#!/bin/sh
# Sourced by lefthook before every hook job (`rc` in lefthook.yml).
#
# Git hooks inherit the PATH of whatever invoked git. A GUI client, an editor,
# or a shell whose version manager still points at an older default therefore
# runs the hook jobs on a Node that predates `fs.globSync` and extensionless
# ESM bin resolution — the scripts fail inside their own runner, with no
# engines check to name the cause.
#
# Selecting the repository's `.nvmrc` version here fixes the interpreter at the
# hook boundary instead. Every step is conditional: a contributor without nvm,
# or one whose PATH already resolves a conforming Node, is left untouched.

[ -n "$NVM_DIR" ] || NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # nvm is a shell function, and its loader is verbose on some setups.
  . "$NVM_DIR/nvm.sh" --no-use >/dev/null 2>&1 \
    && { nvm use >/dev/null 2>&1 || nvm use default >/dev/null 2>&1; }
fi

# The same gap applies to pnpm, which `pre-push` invokes: its global bin lives
# outside the default PATH, so a hook that did not inherit an interactive shell
# fails with "pnpm: command not found" before typecheck starts.
if ! command -v pnpm >/dev/null 2>&1; then
  for candidate in \
    "$PNPM_HOME" "$PNPM_HOME/bin" \
    "$HOME/.local/share/pnpm" "$HOME/.local/share/pnpm/bin" \
    "$HOME/Library/pnpm" "$HOME/Library/pnpm/bin"
  do
    if [ -n "$candidate" ] && [ -x "$candidate/pnpm" ]; then
      PATH="$candidate:$PATH"
      export PATH
      break
    fi
  done
fi
