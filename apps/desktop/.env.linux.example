# Linux Desktop release settings. Copy to .env.linux and fill in the local values.
# Git ignores apps/desktop/.env.linux; this template carries no credentials.
#
# An AppImage is unsigned: a Linux release needs no signing or notarization input, so .env.linux
# admits only the shared release settings and rejects every macOS or Windows field.
# Values are read only from this file, never from the shell, and are not shell-expanded.

# Application identifier; reverse-DNS. Also the Linux desktopName base and the update identity.
DSH_DESKTOP_APP_ID=com.example.desktop

# Update deployment: test or production. Omit to select test.
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# npm registry the packaged runtime installs from. Omit for the default registry.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org/

# Mandatory-update policy: the JSON the packaged shell reads, plus each deployment's origin.
# The selected deployment's origin is required before any artifact is prepared.
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.invalid"]}'

# Test deployment: a 32-character lowercase hexadecimal release ID and the HTTPS feed origin.
DOWNLOAD_TEST_RELEASE_ID=
DOWNLOAD_TEST_ORIGIN=
# Bucket and credentials belong to the upload command; packaging reads neither.
DOWNLOAD_TEST_COS_BUCKET=
DOWNLOAD_TEST_COS_SECRET_ID=
DOWNLOAD_TEST_COS_SECRET_KEY=

# Production deployment, used when DSH_DESKTOP_AUTO_UPDATE_ENV=production.
DOWNLOAD_PROD_COS_BUCKET=
DOWNLOAD_PROD_COS_SECRET_ID=
DOWNLOAD_PROD_COS_SECRET_KEY=
